{
  "name": "nightfire-launcher",
  "productName": "NightFire Launcher",
  "version": "1.4.2",
  "description": "007: NightFire PC port launcher: builds the game from your own disc image, its settings, its HD textures",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "service": "cmd /c build_service.bat",
    "service:linux": "bash build_service.sh",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.hk21x.nightfire.launcher",
    "productName": "NightFire Launcher",
    "directories": {
      "output": "../../out/launcher-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "icon": "../icon.ico",
      "target": [
        "portable"
      ],
      "extraResources": [
        {
          "from": "../../out/launcher-svc/NightFireLauncherService.exe",
          "to": "NightFireLauncherService.exe"
        }
      ]
    },
    "portable": {
      "artifactName": "NightFireLauncher.exe",
      "unpackDirName": "NightFireLauncher"
    },
    "linux": {
      "icon": "../icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "NightFireLauncher-x86_64.AppImage",
      "extraResources": [
        {
          "from": "../../out/launcher-svc/NightFireLauncherService",
          "to": "NightFireLauncherService"
        },
        {
          "from": "../icon.png",
          "to": "icon.png"
        }
      ]
    }
  },
  "author": {
    "name": "NightFire PC port"
  },
  "homepage": "https://github.com/papand7/nightfire-recomp"
}
