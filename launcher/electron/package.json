{
  "name": "nightfire-launcher",
  "productName": "007 Remastered",
  "version": "1.6.1",
  "description": "007 Remastered: the NightFire and Agent Under Fire PC ports' launcher: builds each game from your own disc image, its settings, its HD textures",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "service": "cmd /c build_service.bat",
    "service:linux": "bash build_service.sh",
    "bundles": "node source_bundles.js",
    "dist": "node source_bundles.js && electron-builder --win portable",
    "dist:linux": "node source_bundles.js && electron-builder --linux AppImage",
    "dist:mac": "node source_bundles.js && electron-builder --mac dmg",
    "dist:mac-app": "node source_bundles.js && electron-builder --mac dir"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.hk21x.nightfire.launcher",
    "productName": "007 Remastered",
    "directories": {
      "output": "../../out/launcher-electron"
    },
    "files": [
      "main.js",
      "android-package.sh",
      "preload.js",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "icon": "../icon.ico",
      "target": [
        "portable"
      ],
      "extraResources": [
        {
          "from": "../../out/launcher-svc/NightFireLauncherService.exe",
          "to": "NightFireLauncherService.exe"
        },
        {
          "from": "../../out/launcher-svc-auf/AgentUnderFireLauncherService.exe",
          "to": "AgentUnderFireLauncherService.exe"
        },
        {
          "from": "../icon.ico",
          "to": "icon.ico"
        },
        {
          "from": "../../out/source-bundles",
          "to": "source"
        },
        {
          "from": "../../out/source-bundles-auf",
          "to": "source-auf"
        }
      ]
    },
    "portable": {
      "artifactName": "007Remastered.exe",
      "unpackDirName": "007Remastered"
    },
    "mac": {
      "icon": "../icon-512.png",
      "artifactName": "007Remastered-macOS-arm64.dmg",
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "../../out/launcher-svc/NightFireLauncherService",
          "to": "NightFireLauncherService"
        },
        {
          "from": "../../out/launcher-svc-auf/AgentUnderFireLauncherService",
          "to": "AgentUnderFireLauncherService"
        },
        {
          "from": "../../out/source-bundles",
          "to": "source"
        },
        {
          "from": "../../out/source-bundles-auf",
          "to": "source-auf"
        }
      ]
    },
    "linux": {
      "icon": "../icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "007Remastered-x86_64.AppImage",
      "extraResources": [
        {
          "from": "../../out/launcher-svc/NightFireLauncherService",
          "to": "NightFireLauncherService"
        },
        {
          "from": "../../out/launcher-svc-auf/AgentUnderFireLauncherService",
          "to": "AgentUnderFireLauncherService"
        },
        {
          "from": "../../out/source-bundles",
          "to": "source"
        },
        {
          "from": "../../out/source-bundles-auf",
          "to": "source-auf"
        },
        {
          "from": "../icon.png",
          "to": "icon.png"
        }
      ]
    }
  },
  "author": {
    "name": "007 Remastered"
  },
  "homepage": "https://github.com/papand7/nightfire-recomp"
}
