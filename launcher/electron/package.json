{
  "name": "nightfire-launcher",
  "productName": "NightFire Launcher",
  "version": "1.1.0",
  "description": "007: NightFire PC port launcher: builds the game from your own disc image, its settings, its HD textures",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "service": "cmd /c ..\\..\\.local\\vk\\build_launcher.bat",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.hk21x.nightfire.launcher",
    "productName": "NightFire Launcher",
    "directories": { "output": "../../out/launcher-electron" },
    "files": ["main.js", "preload.js", "ui/**/*", "package.json"],
    "extraResources": [
      { "from": "../../out/launcher-svc/NightFireLauncherService.exe", "to": "NightFireLauncherService.exe" }
    ],
    "win": {
      "icon": "../icon.ico",
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "NightFireLauncher.exe",
      "unpackDirName": "NightFireLauncher"
    }
  }
}
